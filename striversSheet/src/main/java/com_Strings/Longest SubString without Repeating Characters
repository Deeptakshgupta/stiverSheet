  public int lengthOfLongestSubstring(String str) {
        boolean[] map = new boolean[128];
        int left = 0;
        int ans = 0;
        char[] ch = str.toCharArray();
        for (int right = 0; right < str.length(); right++) {
            if (map[ch[right]]) {
                while (left < right && map[ch[right]]) {
                    map[ch[left]] = false;
                    left++;
                }
            }
            map[ch[right]] = true;
            int curr = right - left + 1;
            if (ans < curr)
                ans = curr;
        }
        return ans;
    }

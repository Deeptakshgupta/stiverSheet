//use 2 pointers 
// move one of the pointer n positions ahead
// then when the 2nd pointer reaches the end of the list
// 1st pointer will reach the nth from end

class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
// Using the dummy node -> pointing one place before the head 
// starting with this node instead of head
// this will point to one position before the node which we want to delete
        ListNode res = new ListNode(0,head);

        ListNode dummy = res;

        for( int i =0; i< n;i++)
            head = head.next;

        while(head!= null){
            head= head.next;
            dummy = dummy.next;
        }

        dummy.next = dummy.next.next;
        return res.next;

    }
}

// use binary serach 
// with keeping check of the rotation
// using if else case
// using base cases in if statements and rotated scenarios in rotated cases

class Solution {
    public int search(int[] nums, int target) {
       int low =0; 
int high = nums.length - 1 ;

while(low<= high){
	int mid = (low + high) / 2;
	if(nums[mid] == target)
			return mid;
	else if( nums[mid] <= nums[high])
	{
		if(nums[mid] < target && nums[high]>=target)
				low = mid+1;
		else	
			high = mid-1;
	}
	else{
		if(nums[mid] >target && nums[low]<=target)
			high = mid-1;
		else
			low = mid+1;	
	}
}
return -1; 
    }
}
